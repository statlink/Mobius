mvmf.mle <- function(y, maxit = 1000, tol = 1e-6) {

  dm <- dim(y)
  n <- dm[1]  ;  d <- dm[2] - 1
  nu <- 0.5 * (d - 1)

  logbesselI <- function(kappa, nu)  log(besselI(kappa, nu, expon.scaled = TRUE)) + kappa

  nll <- function(par, mu1, mu2, y, d, n, nu) {
    kappa <- exp(par[1])
    rho <- 2 * plogis(par[2]) - 1
    if (abs(rho) >= 1) return(1e10)
    A <- 1 - rho^2
    s <- drop(y %*% mu2)
    D <- 1 + rho^2 - 2 * rho * s
    w <- 1 / D
    phi <- rho * mu2
    y_minus_phi <- y - rep(phi, each = n)
    M <- A * w * y_minus_phi - rep(phi, each = n)
    log_c_vmf <- nu * log(kappa) - logbesselI(kappa, nu) - 0.5 * (d + 1) * log(2 * pi)
    log_lik <- n * log_c_vmf + n * d * log(A) + kappa * sum(M %*% mu1) - d * sum(log(D))
    - log_lik
  }

  loglik <- function(mu1, mu2, kappa, rho, y, d, n, nu) {
    -nll( c(log(kappa), qlogis((rho + 1) / 2)), mu1, mu2, y, d, n, nu )
  }

  update_mu1 <- function(mu1, mu2, kappa, rho, y, d, n) {
    A <- 1 - rho^2
    s <- drop(y %*% mu2)
    D <- 1 + rho^2 - 2 * rho * s
    w <- 1 / D
    phi <- rho * mu2
    y_minus_phi <- y - rep(phi, each = n)
    M <- A * w * y_minus_phi - rep(phi, each = n)
    g <- kappa * Rfast::colsums(M)
    g <- g - sum(g * mu1) * mu1
    ll0 <- loglik(mu1, mu2, kappa, rho, y, d, n, nu)
    step <- 1 / max(abs(g) + 1e-10)
    repeat {
      mu_new <- mu1 + step * g
      mu_new <- mu_new / sqrt(sum(mu_new^2))
      if ( loglik(mu_new, mu2, kappa, rho, y, d, n, nu) > ll0 || step < 1e-10 )  break
      step <- step / 2
    }
    mu_new
  }

  update_mu2 <- function(mu1, mu2, kappa, rho, y, d, n) {
    A <- 1 - rho^2
    s <- drop(y %*% mu2)
    D <- 1 + rho^2 - 2 * rho * s
    w <- 1 / D
    Nn <- drop(y %*% mu1) - rho * sum(mu1 * mu2)
    Swy  <- Rfast::eachcol.apply(y, w, oper = "*")
    Swy2 <- Rfast::eachcol.apply(y, w^2 * Nn, oper = "*")
    Ssum <- n + A * sum(w)
    g <-  - kappa * rho * Ssum * mu1 + 2 * rho * (kappa * A * Swy2 + d * Swy)
    g <- g - sum(g * mu2) * mu2
    ll0 <- loglik(mu1, mu2, kappa, rho, y, d, n, nu)
    step <- 1 / max(abs(g) + 1e-10)
    repeat {
      mu_new <- mu2 + step * g
      mu_new <- mu_new / sqrt(sum(mu_new^2))
      if ( loglik(mu1, mu_new, kappa, rho, y, d, n, nu) > ll0 || step < 1e-10 )  break
      step <- step / 2
    }
    mu_new
  }


  mu1 <- Rfast::colmeans(y)
  mu1 <- mu1 / sqrt(sum(mu1^2))
  mu2 <- mu1
  kappa <- 1  ;  rho <- 0.5

  opt <- optim( c(log(kappa), qlogis((rho + 1) / 2)), nll, mu1 = mu1, mu2 = mu2, y = y, d = d,
                n = n, nu = nu, control = list(maxit = 5000) )
  kappa <- exp(opt$par[1])   ;   rho <- 2 * plogis(opt$par[2]) - 1
  lik2 <- -opt$value

  for ( it in 1:maxit ) {
    lik1 <- lik2
    mu1 <- update_mu1(mu1, mu2, kappa, rho, y, d, n)
    mu2 <- update_mu2(mu1, mu2, kappa, rho, y, d, n)
    opt <- optim( c(log(kappa), qlogis((rho + 1) / 2)), nll, mu1 = mu1, mu2 = mu2, y = y, d = d,
                 n = n, nu = nu, control = list(maxit = 5000) )
    kappa <- exp(opt$par[1])   ;   rho <- 2 * plogis(opt$par[2]) - 1
    lik2 <-  - opt$value
    if ( abs(lik2 - lik1) < tol )  break
  }

  list(mu1 = mu1, mu2 = mu2, kappa = kappa, rho = rho, loglik = lik2, iters = it + 1)
}




